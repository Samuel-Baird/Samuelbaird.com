---
import Base from '../layouts/Base.astro';
import Title from '../components/Title.astro';
import fonts from '../data/fonts.json';
const sample = Array.from({ length: 80 }, (_, i) => String.fromCodePoint(0x10400 + i)).join('');
const faces = fonts.map((f) => `@font-face{font-family:"dw-${f.id}";src:url("${f.file}");font-display:swap}`).join('');
const kb = (b) => (b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.round(b / 1024) + ' KB');
---
<Base title="Fonts — Deseret Wiki">
  <div class="wrap">
  <header class="page-head">
    <p class="kicker">Typefaces</p>
    <Title text="Fonts" />
    <p class="lede-text">Download and install a font to see the Deseret alphabet in Word, Excel or anywhere else. {fonts.length} fonts.</p>
    <p class="small">Samples show all 80 letters (U+10400–1044F); a font may lack some.</p>
  </header>
  <style set:html={faces}></style>
  <table class="fonts" data-no-dsrt>
    <thead><tr><th>Font</th><th>Sample</th><th></th></tr></thead>
    <tbody>
      {fonts.map((f) => (
        <>
          <tr>
            <td>{f.name}</td>
            <td class="sample" style={`font-family:"dw-${f.id}", serif`} lang="und">{sample}</td>
            <td class="btns">
              <button type="button" class="info" aria-label={`About ${f.name}`} aria-expanded="false" data-info={f.id}>i</button>
              <a class="dl" href={f.file} download aria-label={`Download ${f.name}`}>⤓</a>
            </td>
          </tr>
          <tr class="detail" id={`info-${f.id}`} hidden>
            <td colspan="3">
              <b>{f.name}</b> — {f.category}, {f.license} license, {kb(f.bytes)}.
              {f.creator && <> By {f.creator}.</>}
              {f.source && <> <a href={f.source} rel="noopener">Source</a>.</>}
              {f.note && <> {f.note}</>}
              {f.license === 'Free' && <> <small>Redistribution terms unverified; check the source before reusing.</small></>}
            </td>
          </tr>
        </>
      ))}
    </tbody>
  </table>
  </div>
  <script>
    document.querySelectorAll('button.info').forEach((b) => b.addEventListener('click', () => {
      const row = document.getElementById('info-' + b.dataset.info);
      row.hidden = !row.hidden;
      b.setAttribute('aria-expanded', String(!row.hidden));
    }));
  </script>
  <style>
    .fonts { width: 100%; border-collapse: collapse; font-size: 1rem; border-top: 3px double var(--rule); }
    .fonts th { text-align: left; font: 600 .62rem/1.3 var(--f-formal); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-soft); border-bottom: 1px solid var(--rule); padding: .7rem .6rem; }
    .fonts td { border-bottom: 1px solid var(--rule); padding: .8rem .6rem; vertical-align: middle; }
    .fonts td:first-child { font: 1.08rem/1.3 var(--f-display); color: var(--heading); width: 13rem; }
    .fonts td.sample { font-size: 1.4rem; line-height: 1.35; word-break: break-all; color: var(--ink); }
    .fonts td.btns { white-space: nowrap; text-align: right; width: 5.5rem; }
    .fonts .info, .fonts .dl { display: inline-grid; place-items: center; width: 2rem; height: 2rem; border: 1px solid var(--heading); border-radius: 1px; background: transparent; color: var(--heading); cursor: pointer; font: italic 1rem/1 var(--f-display); text-decoration: none; padding: 0; margin-left: .25rem; }
    .fonts .dl { background: var(--heading); color: var(--paper); font-style: normal; }
    .fonts .info:hover { background: var(--paper-2); }
    .fonts .detail td { font-size: .9rem; background: var(--paper-2); }
    @media (max-width: 640px) {
      .fonts thead { display: none; }
      .fonts tr:not(.detail) { display: grid; grid-template-columns: 1fr auto; }
      .fonts tr:not(.detail) td { border: 0; }
      .fonts tr:not(.detail) { border-bottom: 1px solid var(--rule); }
      .fonts td:first-child { width: auto; }
      .fonts td.sample { grid-column: 1 / -1; grid-row: 2; padding-top: 0; }
    }
  </style>
</Base>
