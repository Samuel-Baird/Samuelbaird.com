---
import Base from '../layouts/Base.astro';
import Title from '../components/Title.astro';
const videos = [
  { id: 'THZP0NeBSps', title: 'Mormon Alphabet Reform: Failed but Impressive (Deseret Alphabet)', by: 'Palm Springs Linguist' },
  { id: 'PXsjQUExznc', title: 'What is the Deseret Alphabet? (Ep. 178)', by: 'Saints Unscripted' },
  { id: 'nsFCIc14-Wc', title: 'The Deseret Alphabet Introduction', by: 'Amaronian Broadcasting', list: 'PLsp8JpNzjzmxFedU-wTIo4ES8eQ7iFbyz' },
  { id: '_nyWsRd_fY4', title: 'Assailing Mists of Tradition: The Deseret Alphabet Experience (2026-11-11)', by: 'The Book Club of California' },
  { id: 'ypYK-v-HXDE', title: "The history behind Utah's unique and mostly forgotten alphabet", by: 'FOX 13 News Utah' },
  { id: 'qMVaUnBZPZE', title: 'The Secret Alphabet Early Utah Mormons Tried to Replace English With', by: 'WARD RADIO' },
  { id: 'AiBY7ehB-jk', title: 'I analyzed 2,000 bindings of the same book', by: 'Alexander Jolley' },
  { id: 'p9LPI8BVVbI', title: 'Why Mormons Made Their Own Alphabet', by: 'Etymology Nerd', short: true },
  { id: 'zjMNiJHFv2c', title: 'The Mormons fixed the alphabet', by: 'Chessed Gamon', short: true },
];
---
<Base title="Videos — Deseret Wiki">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">Moving Pictures</p>
      <Title text="Videos" />
      <p class="lede-text">Lectures and short documentaries on the Deseret Alphabet.</p>
    </header>
    {videos.map((v) => (
      <section class="video">
        <div class="vid frame"><div class="vid-inner"><iframe src={`https://www.youtube-nocookie.com/embed/${v.id}`} title={v.title} loading="lazy" allowfullscreen></iframe></div></div>
        <h2>{v.title}</h2>
        <p class="small">{v.by} · <a href={v.short ? `https://www.youtube.com/shorts/${v.id}` : `https://www.youtube.com/watch?v=${v.id}${v.list ? `&list=${v.list}` : ''}`} rel="noopener">Watch on YouTube</a></p>
      </section>
    ))}
  </div>
  <style>
    .video { max-width: 52rem; margin-bottom: 3rem; }
    .video h2 { margin: 1.2rem 0 .3rem; font-size: 1.5rem; }
    .vid { padding: .6rem; }
    .vid-inner { position: relative; padding-top: 56.25%; background: var(--paper-2); }
    .vid.short { max-width: 360px; padding-top: 640px; }
    .vid iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  </style>
</Base>
