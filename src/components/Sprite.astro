---
// Engraved emblems as one inline sprite: <svg><use href="#i-skep"/></svg>.
// Everything is drawn in currentColor so it follows the theme. Kept off-screen rather than
// display:none, which would break the hatch patterns and clip paths in some browsers.
const f = (n) => +n.toFixed(2);
const polar = (cx, cy, r, a) => [f(cx + r * Math.cos(a)), f(cy + r * Math.sin(a))];

// all-seeing eye: rays
const eyeRays = Array.from({ length: 24 }, (_, i) => {
  const a = (i / 24) * Math.PI * 2;
  const long = i % 2 === 0;
  const [x1, y1] = polar(32, 32, 24, a);
  const [x2, y2] = polar(32, 32, long ? 31 : 28, a);
  return `M${x1} ${y1}L${x2} ${y2}`;
}).join('');

// sun rays (straight and flame-shaped, alternating)
const sunRays = Array.from({ length: 16 }, (_, i) => {
  const a = (i / 16) * Math.PI * 2;
  const [x1, y1] = polar(20, 22, 11, a);
  if (i % 2) { const [x2, y2] = polar(20, 22, 15, a); return `M${x1} ${y1}L${x2} ${y2}`; }
  const [x2, y2] = polar(20, 22, 18, a);
  const [cx, cy] = polar(20, 22, 15, a + 0.12);
  return `M${x1} ${y1}Q${cx} ${cy} ${x2} ${y2}`;
}).join('');

const star = (cx, cy, r) => Array.from({ length: 10 }, (_, i) => {
  const a = -Math.PI / 2 + (i * Math.PI) / 5;
  const [x, y] = polar(cx, cy, i % 2 ? r * 0.42 : r, a);
  return `${i ? 'L' : 'M'}${x} ${y}`;
}).join('') + 'Z';

const spokes = (cx, cy, r, n) => Array.from({ length: n }, (_, i) => {
  const a = (i / n) * Math.PI * 2;
  const [x1, y1] = polar(cx, cy, 2.2, a);
  const [x2, y2] = polar(cx, cy, r, a);
  return `M${x1} ${y1}L${x2} ${y2}`;
}).join('');

// skep coils and the stitches that bind them
const coilYs = [47, 41.5, 36, 30.5, 25, 19.5, 14.5];
const coils = coilYs.map((y) => `M4 ${y}Q32 ${y + 3.2} 60 ${y}`).join('');
const stitches = coilYs.slice(0, -1).flatMap((y, row) =>
  [14, 22, 30, 38, 46].map((x) => { const xx = x + (row % 2) * 4; return `M${xx} ${f(y - 4.2)}l.6 4.4`; })).join('');
const skepShade = Array.from({ length: 10 }, (_, i) => `M${44 + i * 1.3} 52L${50 + i * 1.3} 12`).join('');
---
<svg class="sprite" aria-hidden="true" width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden">
  <defs>
    <pattern id="hatch" width="3" height="3" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <path d="M0 0V3" stroke="currentColor" stroke-width=".7" />
    </pattern>
    <pattern id="hatch-fine" width="2.2" height="2.2" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
      <path d="M0 0V2.2" stroke="currentColor" stroke-width=".45" />
    </pattern>
    <clipPath id="skep-clip"><path d="M11 52C11 31 19 13.5 32 11.5C45 13.5 53 31 53 52Z" /></clipPath>
    <clipPath id="bee-abdomen"><ellipse cx="11.5" cy="19.5" rx="8" ry="5.4" /></clipPath>
    <mask id="moon-mask"><rect width="64" height="64" fill="#fff" /><circle cx="50.5" cy="37" r="8" fill="#000" /></mask>
  </defs>

  <!-- Skep beehive -->
  <symbol id="i-skep" viewBox="0 0 64 64">
    <g fill="none" stroke="currentColor" stroke-linecap="round">
      <g clip-path="url(#skep-clip)">
        <path d={coils} stroke-width="1.5" />
        <path d={stitches} stroke-width=".9" />
        <path d={skepShade} stroke-width=".5" opacity=".7" />
      </g>
      <path d="M11 52C11 31 19 13.5 32 11.5C45 13.5 53 31 53 52" stroke-width="1.8" />
      <path d="M29.5 11.8c0-3.4 5-3.4 5 0" stroke-width="1.5" />
      <path d="M5 52.5h54" stroke-width="2.4" />
      <path d="M8 56.5h48" stroke-width="1" />
    </g>
    <path d="M27 52v-4.6a5 5 0 0 1 10 0V52z" fill="currentColor" />
  </symbol>

  <!-- Honeybee (wings are animatable: .wing) -->
  <symbol id="i-bee" viewBox="0 0 32 32">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path class="wing" d="M14.5 15C9 14 5.5 7 9.5 4.5C13.5 2.2 17 9 14.5 15Z" stroke-width=".9" />
      <path class="wing" d="M16.5 15C16.5 9 21.5 3.6 25 5.4C28.4 7.6 22.5 13.6 16.5 15Z" stroke-width=".9" />
      <path d="M10.5 6.5l3.2 7M20.5 7.5l-3.5 6.3" stroke-width=".4" />
      <g clip-path="url(#bee-abdomen)" fill="currentColor" stroke="none">
        <rect x="7" y="13" width="2.1" height="14" /><rect x="10.8" y="13" width="2.1" height="14" /><rect x="14.6" y="13" width="2.1" height="14" />
      </g>
      <ellipse cx="11.5" cy="19.5" rx="8" ry="5.4" stroke-width="1.1" />
      <path d="M3.6 19.6L1.2 20.1" stroke-width="1" />
      <circle cx="21.6" cy="18.4" r="3.6" fill="url(#hatch)" stroke-width="1" />
      <circle cx="26.6" cy="17.2" r="2.6" stroke-width="1" />
      <circle cx="27.4" cy="16.7" r=".7" fill="currentColor" stroke="none" />
      <path d="M27.8 14.9c.8-2.1 2-3.1 3.4-3.3M26.4 14.8c.3-2.3 1.1-3.5 2.3-4.1" stroke-width=".7" />
      <path d="M19.5 21.7l-1.3 3.6M21.8 22l.1 3.8M24 21.2l1.8 3.2" stroke-width=".7" />
    </g>
  </symbol>

  <!-- Victorian flourish (one side; mirror with scale(-1,1)) -->
  <symbol id="i-flourish" viewBox="0 0 120 16" preserveAspectRatio="xMaxYMid meet">
    <g fill="none" stroke="currentColor" stroke-linecap="round">
      <path d="M120 8H68C60 8 56 3.5 48 3.5C40 3.5 37 8.5 40.5 11C43.5 13 47 9.5 44 7.5" stroke-width="1" />
      <path d="M68 8C61 8 57 12.5 49 12.5C39 12.5 30 5 18 6.5C10 7.5 6 9 2 8" stroke-width=".75" />
    </g>
    <path d="M30 7.6C27 3.2 22 3 19.6 5C23 5.4 26 6.4 30 7.6Z" fill="currentColor" />
    <circle cx="1.6" cy="8" r="1.3" fill="currentColor" />
  </symbol>

  <!-- All-seeing eye -->
  <symbol id="i-eye" viewBox="0 0 64 64">
    <g fill="none" stroke="currentColor" stroke-linecap="round">
      <path d={eyeRays} stroke-width=".9" />
      <path d="M11 32C20 19 44 19 53 32C44 45 20 45 11 32Z" stroke-width="1.6" />
      <path d="M15 25C24 16.5 40 16.5 49 25" stroke-width=".8" />
      <circle cx="32" cy="32" r="8.4" fill="url(#hatch-fine)" stroke-width="1.2" />
      <circle cx="32" cy="32" r="3.6" fill="currentColor" stroke="none" />
      <circle cx="34.2" cy="29.8" r="1.2" style="fill:var(--paper)" stroke="none" />
    </g>
  </symbol>

  <!-- Sun, moon and stars -->
  <symbol id="i-sunmoon" viewBox="0 0 64 64">
    <g fill="none" stroke="currentColor" stroke-linecap="round">
      <path d={sunRays} stroke-width=".9" />
      <circle cx="20" cy="22" r="8.5" stroke-width="1.4" fill="url(#hatch-fine)" />
      <path d="M16.5 20.5h1.6M22 20.5h1.6M17.5 25.4c1.6 1.2 3.4 1.2 5 0" stroke-width=".9" />
    </g>
    <circle cx="46" cy="40" r="10" fill="currentColor" mask="url(#moon-mask)" />
    <path d={star(50, 14, 3.6) + star(58, 26, 2.2) + star(33, 50, 2.6) + star(12, 48, 1.8) + star(40, 24, 1.6)} fill="currentColor" />
  </symbol>

  <!-- Clasped hands, as on the 1849 Deseret gold coinage -->
  <symbol id="i-hands" viewBox="0 0 64 64">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 25.5h11v15H2" stroke-width="1.3" />
      <path d="M5 25.5v15M8.5 25.5v15" stroke-width=".6" />
      <path d="M62 23.5H51v15h11" stroke-width="1.3" />
      <path d="M59 23.5v15M55.5 23.5v15" stroke-width=".6" />
      <path d="M13 27.5C21 25.5 30 25.2 37 27.3C41 28.6 42.3 31.4 39.5 33L31 33.6C34.6 35.2 36 37.6 33.8 39.6L13 39.8" stroke-width="1.4" />
      <path d="M51 24C43 23.5 33 23.6 26.3 26.3C22.8 27.8 23.6 30.8 27.4 31.4C25.6 32.8 26 35.6 29.6 36.8C34 38.2 44 38.6 51 38.2" stroke-width="1.4" />
      <path d="M27.4 31.4L38 31.8M29.6 36.8L37 36.9M29.4 29.2c3 .2 6 .3 9 .1" stroke-width=".7" />
      <path d="M44 26.5c-2 3.5-2 7 0 10M47 26c-1.4 3.8-1.4 7.4 0 11" stroke-width=".5" opacity=".8" />
      <path d="M17 29.5c-1.2 3-1.2 6 0 8.5M20 29c-1 3.2-1 6.4 0 9" stroke-width=".5" opacity=".8" />
    </g>
  </symbol>

  <!-- Pioneer covered wagon -->
  <symbol id="i-wagon" viewBox="0 0 100 64">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17 34C12.5 21 14 10.5 22 8.2C40 4 60 4 78 8.2C86 10.5 87.5 21 83 34Z" stroke-width="1.5" />
      <path d="M31 34C29.6 22 29.8 12 31.5 6.2M45 34C44.4 22 44.6 11 45.4 5.3M59 34C59.4 22 59.6 11 58.8 5.4M71 34C72.4 22 72.4 12 70.6 6.5" stroke-width=".8" />
      <path d="M17 34C12.5 21 14 10.5 22 8.2C20 14 20 24 22 34Z" fill="url(#hatch-fine)" stroke-width=".6" />
      <rect x="14" y="34" width="72" height="11" stroke-width="1.5" />
      <path d="M14 39.5h72" stroke-width=".6" />
      <path d="M86 42l13 4" stroke-width="1.3" />
      <circle cx="28" cy="50" r="11" stroke-width="1.6" />
      <circle cx="28" cy="50" r="9.4" stroke-width=".5" />
      <path d={spokes(28, 50, 9.4, 12)} stroke-width=".8" />
      <circle cx="73" cy="49" r="12.5" stroke-width="1.6" />
      <circle cx="73" cy="49" r="10.9" stroke-width=".5" />
      <path d={spokes(73, 49, 10.9, 14)} stroke-width=".8" />
    </g>
    <circle cx="28" cy="50" r="2.2" fill="currentColor" /><circle cx="73" cy="49" r="2.4" fill="currentColor" />
  </symbol>

  <!-- Sego lily, Utah's native flower -->
  <symbol id="i-sego" viewBox="0 0 48 64">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 30C14 28 9.5 18 13.5 9.5C18 15.5 22 20 24 30Z" stroke-width="1.2" />
      <path d="M24 30C34 28 38.5 18 34.5 9.5C30 15.5 26 20 24 30Z" stroke-width="1.2" />
      <path d="M24 30C19.8 22 20 12 24 5.5C28 12 28.2 22 24 30Z" stroke-width="1.2" style="fill:var(--paper)" />
      <path d="M24 26C22.6 20 22.6 14 24 9M16 14c2 5 4.6 9 7 13M32 14c-2 5-4.6 9-7 13" stroke-width=".5" />
      <path d="M15.2 17c1.5 3.8 4 7.5 7.8 11.6M14.4 13c.6 1.8 1.4 3.6 2.5 5.5" stroke-width=".4" />
      <circle cx="24" cy="21" r="1.4" fill="currentColor" stroke="none" />
      <path d="M24 30C24 42 23.2 52 22.4 62" stroke-width="1.2" />
      <path d="M23 50C16 46 10 40 8 33.5C14 38 19.6 42.4 23 50Z" stroke-width="1" fill="url(#hatch-fine)" />
      <path d="M22.8 56C29 50 35 44.6 39.6 37.5" stroke-width="1" />
    </g>
  </symbol>

  <!-- Open primer -->
  <symbol id="i-primer" viewBox="0 0 64 48">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M32 10C24 6 12 6 4 9V42C12 39 24 39 32 43Z" stroke-width="1.4" />
      <path d="M32 10C40 6 52 6 60 9V42C52 39 40 39 32 43Z" stroke-width="1.4" />
      <path d="M2 11v33c10-3 22-2.6 30 1c8-3.6 20-4 30-1V11" stroke-width=".8" />
      <path d="M9 15h17M9 19h15M9 23h17M9 27h13M9 31h16M9 35h11" stroke-width=".7" />
      <path d="M36 37c6-1.6 13-1.8 19-.6" stroke-width=".5" />
    </g>
    <text x="46" y="27" text-anchor="middle" font-family="Noto Sans Deseret" font-size="13" fill="currentColor">𐐔𐐯</text>
  </symbol>

  <!-- Type sorts -->
  <symbol id="i-sorts" viewBox="0 0 64 64">
    <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round">
      <path d="M8 22l13-5 13 5-13 5z" stroke-width="1.2" />
      <path d="M8 22v26l13 5V27z" stroke-width="1.2" />
      <path d="M21 27v26l13-5V22z" stroke-width="1.2" fill="url(#hatch-fine)" />
      <path d="M8 30l13 5M8 32.5l13 5" stroke-width=".6" />
      <path d="M32 14l13-5 13 5-13 5z" stroke-width="1.2" />
      <path d="M32 14v26l13 5V19z" stroke-width="1.2" />
      <path d="M45 19v26l13-5V14z" stroke-width="1.2" fill="url(#hatch-fine)" />
      <path d="M32 22l13 5M32 24.5l13 5" stroke-width=".6" />
      <path d="M17.6 20.6l3.2 2.6 3.4-2.4M18.5 22.9h5" stroke-width="1.1" />
      <path d="M41.6 12.2c2 .4 4 .4 6.4-.4M42.4 14.6c1.6-.6 3.5-.6 5 0" stroke-width="1.1" />
    </g>
  </symbol>

  <!-- Honeycomb -->
  <symbol id="i-comb" viewBox="0 0 64 64">
    <g fill="none" stroke="currentColor" stroke-linejoin="round">
      <path d="M32 8l9 5.2v10.4l-9 5.2-9-5.2V13.2zM14 18.4l9 5.2v10.4l-9 5.2-9-5.2V23.6zM50 18.4l9 5.2v10.4l-9 5.2-9-5.2V23.6zM32 28.8l9 5.2v10.4l-9 5.2-9-5.2V34zM14 39.2l9 5.2v10.4l-9 5.2-9-5.2V44.4zM50 39.2l9 5.2v10.4l-9 5.2-9-5.2V44.4z" stroke-width="1.2" />
      <path d="M32 31.6l6.6 3.8v7.6L32 46.8l-6.6-3.8v-7.6zM14 42l6.6 3.8v7.6L14 57.2l-6.6-3.8v-7.6z" fill="url(#hatch-fine)" stroke-width=".5" />
    </g>
    <use href="#i-bee" x="36" y="44" width="20" height="20" />
  </symbol>

  <!-- Magnifying glass -->
  <symbol id="i-glass" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-linecap="round">
      <circle cx="10" cy="10" r="6.6" stroke-width="1.6" />
      <circle cx="10" cy="10" r="5" stroke-width=".5" />
      <path d="M7 7.6a3.6 3.6 0 0 1 2.4-1.6" stroke-width=".7" />
      <path d="M15 15l1.4 1.4" stroke-width="2.6" />
      <path d="M16.8 16.8l4.4 4.4" stroke-width="2" />
    </g>
  </symbol>

  <!-- Oil lamp (.flame lit in lamplight mode) -->
  <symbol id="i-lamp" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7.5 22h9M9 22c0-2.2 1.3-3.3 3-3.3s3 1.1 3 3.3" stroke-width="1.2" />
      <ellipse cx="12" cy="15.6" rx="5" ry="3" stroke-width="1.2" />
      <path d="M10 12.8h4" stroke-width="1.4" />
      <path d="M10.3 12.6C9 10.6 9.2 8.6 10.6 6.8V3.5h2.8v3.3C14.8 8.6 15 10.6 13.7 12.6" stroke-width="1" />
      <path d="M17 15c2.4 0 2.4 3.4 0 3.4" stroke-width="1" />
    </g>
    <path class="flame" d="M12 11.4c-1.1-.9-1-2.3 0-3.7c1 1.4 1.1 2.8 0 3.7Z" fill="currentColor" />
  </symbol>

  <!-- Side-panel toggle: a bound volume seen from above -->
  <symbol id="i-panel" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4.5" width="18" height="15" rx="1.5" stroke-width="1.4" />
      <path d="M9 4.5v15" stroke-width="1.2" />
      <path d="M5 8h2M5 10.5h2M5 13h2" stroke-width="1" />
    </g>
  </symbol>

  <!-- Books on a shelf -->
  <symbol id="i-books" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 20.5h18" stroke-width="1.4" />
      <rect x="4" y="5" width="3.6" height="15.5" stroke-width="1.2" />
      <rect x="7.6" y="7.5" width="3.4" height="13" stroke-width="1.2" />
      <path d="M12.4 8.6l3.3-.9 3.6 12.6-3.3.9z" stroke-width="1.2" />
      <path d="M4 8h3.6M4 17.5h3.6M7.6 10h3.4M7.6 18h3.4" stroke-width=".8" />
    </g>
  </symbol>

  <!-- Five-point star -->
  <symbol id="i-star" viewBox="0 0 10 10"><path d={star(5, 5.3, 4.8)} fill="currentColor" /></symbol>
</svg>
