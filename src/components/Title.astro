---
// Page <h1> with the Deseret-to-Latin reveal (spellings computed at build time).
import { revealParts } from '../lib/dsrt.js';
interface Props { text: string; class?: string }
const { text, class: cls } = Astro.props;
---
<h1 class={cls} data-dsrt={JSON.stringify(revealParts(text))}>{text}</h1>
