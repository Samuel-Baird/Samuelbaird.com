{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Same name as the Vercel project. Routes / custom domains are added at cutover, not here.
  "name": "peepstone",
  // worker.ts wraps .open-next/worker.js (bare /mcp rewrite).
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
