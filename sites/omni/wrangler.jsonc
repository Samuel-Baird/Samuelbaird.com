{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Custom domain omni.samuelbaird.com is attached in Cloudflare (not here); no workers.dev URL, Omni stays hidden.
  "name": "omni",
  // worker.ts wraps .open-next/worker.js (bare /api/mcp rewrite + noindex header).
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false, // hidden: reachable only via the samuelbaird-com service binding and omni.samuelbaird.com,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
