{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sacred-sites/stats",
      "destination": "/sacred-sites/traditions",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/data/(.*).csv",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/csv; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/scout(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/learn(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/latter-day-stats",
      "destination": "https://latterdaystats.samuelbaird.com/latter-day-stats"
    },
    {
      "source": "/latter-day-stats/:path*",
      "destination": "https://latterdaystats.samuelbaird.com/latter-day-stats/:path*"
    },
    {
      "source": "/urim",
      "destination": "https://urim.samuelbaird.com/urim"
    },
    {
      "source": "/urim/:path*",
      "destination": "https://urim.samuelbaird.com/urim/:path*"
    },
    {
      "source": "/peepstone",
      "destination": "https://peepstone.vercel.app/peepstone"
    },
    {
      "source": "/peepstone/:path*",
      "destination": "https://peepstone.vercel.app/peepstone/:path*"
    },
    {
      "source": "/omni",
      "destination": "https://omni.samuelbaird.com/omni"
    },
    {
      "source": "/omni/:path*",
      "destination": "https://omni.samuelbaird.com/omni/:path*"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "archive/**": false,
      "port/**": false
    }
  }
}
