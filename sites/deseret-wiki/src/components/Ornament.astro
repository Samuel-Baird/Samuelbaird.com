---
// Article divider: flourish · bee · flourish.
interface Props { bee?: boolean; class?: string }
const { bee = true, class: cls = '' } = Astro.props;
---
<div class:list={['ornament', cls]} role="separator" aria-hidden="true">
  <svg class="flourish" viewBox="0 0 120 16" preserveAspectRatio="xMaxYMid meet"><use href="#i-flourish" /></svg>
  {bee ? <svg class="bee" viewBox="0 0 32 32"><use href="#i-bee" /></svg> : <svg class="bee" viewBox="0 0 10 10" style="width:.6rem;height:.6rem"><use href="#i-star" /></svg>}
  <svg class="flourish" viewBox="0 0 120 16" preserveAspectRatio="xMaxYMid meet" style="transform:scaleX(-1)"><use href="#i-flourish" /></svg>
</div>
