---
// Featured-article badge: a pressed wax seal.
interface Props { label?: string; size?: string }
const { label = 'Featured', size = '5.5rem' } = Astro.props;
let s = 7;
const rand = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const pts = Array.from({ length: 36 }, (_, i) => {
  const a = (i / 36) * Math.PI * 2;
  const r = 29 + rand() * 3.2 + (i % 3 === 0 ? 1.6 : 0);
  return `${(32 + r * Math.cos(a)).toFixed(1)} ${(32 + r * Math.sin(a)).toFixed(1)}`;
});
const id = 'wax-' + Math.random().toString(36).slice(2, 7);
---
<span class="waxseal" title={label} style={`--s:${size}`}>
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <defs><path id={id} d="M32 32m-17.5 0a17.5 17.5 0 1 1 35 0a17.5 17.5 0 1 1 -35 0" /></defs>
    <path class="wax" d={`M${pts.join('L')}Z`} />
    <circle cx="32" cy="32" r="23" class="wax-ring" />
    <circle cx="32" cy="32" r="21" class="wax-ring thin" />
    <text class="wax-text" font-size="5" letter-spacing="1.2"><textPath href={`#${id}`}>{label.toUpperCase()} ✦ {label.toUpperCase()} ✦</textPath></text>
    <use href="#i-skep" x="22" y="21" width="20" height="20" class="wax-mark" />
  </svg>
  <span class="visually-hidden">{label}</span>
</span>
<style>
  .waxseal { display: inline-block; width: var(--s); height: var(--s); filter: drop-shadow(0 2px 2px rgb(60 20 10 / .3)); transform: rotate(-8deg); }
  .waxseal svg { width: 100%; height: 100%; display: block; }
  .wax { fill: var(--seal); }
  .wax-ring { fill: none; stroke: rgb(255 230 220 / .35); stroke-width: 1; }
  .wax-ring.thin { stroke-width: .4; }
  .wax-text { fill: rgb(255 235 225 / .7); font-family: Cinzel, serif; }
  .wax-mark { color: rgb(255 235 225 / .75); }
</style>
