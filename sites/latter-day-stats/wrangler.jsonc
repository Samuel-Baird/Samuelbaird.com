{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Custom entry: wraps .open-next/worker.js with the /api + /auth rewrites
  // (formerly vercel.json) and the scheduled() cron handler.
  "main": "worker.ts",
  "name": "latter-day-stats",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  // No routes / custom domains / account_id yet: the cutover adds them.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Same schedule as the old vercel.json crons; scheduled() in worker.ts
  // calls /api/cron/refresh-stats and /api/cron/message-digest.
  "triggers": {
    "crons": ["0 19 * * *"]
  },
  "services": [
    {
      // Used by the memory queue for ISR revalidation. Must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "latter-day-stats"
    }
  ],
  "kv_namespaces": [
    {
      // OpenNext incremental cache (ISR pages + unstable_cache data). KV, not
      // R2: R2 is not enabled on the account. PLACEHOLDER: create the namespace
      // (`npx wrangler kv namespace create latter-day-stats-opennext-cache`)
      // and put its id here before the first deploy.
      "binding": "NEXT_INC_CACHE_KV",
      "id": "bd4f29e73e0b4160a3d2ea3e27817b3d"
    }
  ],
  "d1_databases": [
    {
      // OpenNext tag cache (revalidateTag / revalidatePath).
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "latter-day-stats-tag-cache",
      "database_id": "59d682d8-1001-466c-a683-cd1578d16e85"
    }
  ],
  "images": {
    // next/image optimization through Cloudflare Images.
    "binding": "IMAGES"
  }
}
