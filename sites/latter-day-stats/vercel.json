{
  "crons": [
    {
      "path": "/latter-day-stats/api/cron/refresh-stats",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/latter-day-stats/api/cron/message-digest",
      "schedule": "0 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/latter-day-stats/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/latter-day-stats/auth/:path*"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages/family"
}
