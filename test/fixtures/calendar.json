   "<html><head></head><body><span class=\"version\"> Not after 1 Jan. 1831. Not extant.<aside class=\"popup-wrapper\" id=\"2733118593332853488\"><a href=\"#2733118593332853488\" class=\"editorial-note-static staticPopup\" title=\"Note\" name=\"intro1\"><span id=\"documentintro1\">1</span></a><div class=\"popup-content\"><div class=\"note-data editorial-footnote\" isnote=\"Y\"><p class=\"bottom_0\">In the 28 January 1831 issue of the <span class=\"title\">Wayne Sentinel,</span> “Smith, Joseph Jr.” is included in a list of persons with unclaimed letters at the post office as of 1 Jan. 1831. No further information about this letter is available. (“List of Letters,” <span class=\"title\">Wayne Sentinel</span> (Palmyra, NY), 28 Jan. 1831, [4].)</p><hr><div class=\"works-cited-links\"><a href=\"/works-cited\" class=\"pdf\" id=\"comp-works\">Comprehensive Works Cited</a></div><div class=\"source-note\"><p id=\"source-note1\"><span class=\"title\">Wayne Sentinel.</span> Palmyra, NY. 1823–1852, 1860–1861.</p></div></div></div></aside></span></body></html>"
