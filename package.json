{
  "name": "peepstone",
  "version": "0.1.0",
  "description": "MCP server for searching and reading the Joseph Smith Papers (josephsmithpapers.org)",
  "type": "module",
  "private": true,
  "bin": {
    "peepstone": "./dist/stdio.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "stdio": "tsx src/stdio.ts",
    "build:stdio": "esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/stdio.js --packages=external",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "prepare": "npm run build:stdio"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "cheerio": "^1.2.0",
    "mcp-handler": "^2.3.1",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Samuel-Baird/peepstone.git"
  }
}
