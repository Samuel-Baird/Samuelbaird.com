# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys.

# === Supabase (from Project Settings → API) ===
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# === YouTube Data API v3 (Google Cloud Console) ===
# Used by /api/cron/refresh-stats to fetch fresh channel numbers.
YOUTUBE_API_KEY=AIza...

# === Admin / cron secrets ===
OWNER_EMAIL=b13llama@gmail.com
CRON_SECRET=generate-a-long-random-string-here

# === Email notifications (Resend) ===
# Powers the instant contact-form alert and /api/cron/message-digest.
# Leave RESEND_API_KEY unset locally and no mail is sent (submissions still save).
RESEND_API_KEY=re_...your-resend-api-key...
# Where message notifications go. Defaults to CONTACT_EMAIL in src/lib/contact.ts.
MESSAGE_NOTIFY_EMAIL=ithinksamofficial@gmail.com
# Optional. Only set once a sending domain is verified in Resend; until then the
# default "onboarding@resend.dev" sender works for the Resend account owner.
# EMAIL_FROM=Latter-day Stats <notifications@your-domain.com>
