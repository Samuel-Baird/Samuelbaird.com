# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real keys.

# === Supabase (from Project Settings → API) ===
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# === YouTube Data API v3 (Google Cloud Console) ===
# Used by /api/cron/refresh-stats to fetch fresh channel numbers.
YOUTUBE_API_KEY=AIza...

# === Admin / cron secrets ===
OWNER_EMAIL=b13llama@gmail.com
CRON_SECRET=generate-a-long-random-string-here

# === Email notifications (Resend) ===
# Powers the instant contact-form alert, /api/cron/message-digest (daily admin
# summary), and the monthly subscriber newsletter that rides along on the same
# cron on the 1st of the month (see src/lib/newsletter.ts — Vercel Hobby caps
# a project at 2 cron jobs, so there's no separate schedule for it).
# Leave RESEND_API_KEY unset locally and no mail is sent (submissions still save).
RESEND_API_KEY=re_...your-resend-api-key...
# Where message notifications go. Defaults to CONTACT_EMAIL in src/lib/contact.ts.
MESSAGE_NOTIFY_EMAIL=ithinksamofficial@gmail.com
# Optional. Only set once a sending domain is verified in Resend; until then the
# default "onboarding@resend.dev" sender only delivers to the Resend account
# owner's own address — newsletter sends to other subscribers will fail (and
# get logged/counted, not silently dropped) until this is set.
# EMAIL_FROM=Latter-day Stats <notifications@your-domain.com>

# === Stripe (Dashboard → Developers → API keys) ===
# Powers card donations on /donate. Use sk_test_ keys locally and on previews,
# sk_live_ only in Vercel Production. Unset = the Stripe form is hidden and only
# PayPal/Venmo show.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for /api/stripe/webhook. Locally, `stripe listen
# --forward-to localhost:3000/api/stripe/webhook` prints a whsec_ to use here;
# in production, take it from the webhook endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...
